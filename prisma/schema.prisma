generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum TenantType {
    UNIVERSITY
    SOCIETY
    COLLEGE
    SCHOOL
}

model Tenant {
    id             Int              @id @default(autoincrement())
    name           String           @unique
    description    String?
    slug           String           @unique
    type           TenantType
    parent         Tenant?          @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    parentId       Int?
    children       Tenant[]         @relation("TenantHierarchy")
    address        Json             @default("{}")
    settings       Json             @default("{}")
    contact        Json             @default("{}")
    limits         Json             @default("{}")
    branding       Json             @default("{}")
    customField    Json             @default("{}")
    features       String[]         @default([])
    isActive       Boolean          @default(true)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    users          User[]
    roles          Role[]
    groups         MenuGroup[]
    menus          MenuItem[]
    permissions    Permission[]
    rolePermission RolePermission[]
    auditLogs      AuditLog[]

    @@index([type])
}

model User {
    id               Int                @id @default(autoincrement())
    email            String             @unique
    password         String
    role             Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
    roleId           Int
    globalRoles      Json               @default("[]")
    tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    tenantId         Int?
    isActive         Boolean            @default(true)
    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
    ip               String?
    customFields     Json               @default("{}")
    profile          Profile?
    auditLog         AuditLog[]
    notification     Notification[]
    pushSubscription PushSubscription[]

    @@index([tenantId, email])
}

enum GlobalRole {
    SUPER_ADMIN
    SYSTEM_ADMIN
    SUPPORT
}

model Profile {
    id           Int       @id @default(autoincrement())
    firstName    String
    middleName   String?
    lastName     String
    dateOfBirth  DateTime?
    avatar       String?
    phone        String?
    address      Json?     @default("{}")
    customFields Json      @default("{}")
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId       Int?      @unique

    @@index([firstName, lastName])
}

model Role {
    id          Int              @id @default(autoincrement())
    name        String
    description String?
    tenantId    Int?
    tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    permissions RolePermission[]
    isActive    Boolean          @default(true)
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
    users       User[]

    @@unique([tenantId, name])
}

model RolePermission {
    id             Int      @id @default(autoincrement())
    tenantId       Int?
    tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    roleId         Int
    menuId         Int
    permissionBits Int
    role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
    menus          MenuItem @relation(fields: [menuId], references: [id], onDelete: Cascade)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([tenantId, roleId, menuId])
    @@index([tenantId, roleId])
    @@index([tenantId, menuId])
}

model Permission {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    bitmask   Int
    tenantId  Int?
    tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    isGlobal  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([name, tenantId], name: "permission_name_tenant")
    @@index([tenantId, name])
}

model MenuItem {
    id             Int              @id @default(autoincrement())
    tenantId       Int?
    tenant         Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    name           String
    path           String?
    parentId       Int?
    parent         MenuItem?        @relation("MenuParent", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    children       MenuItem[]       @relation("MenuParent")
    groupId        Int?
    group          MenuGroup?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
    isActive       Boolean          @default(true)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    rolePermission RolePermission[]

    @@unique([tenantId, parentId, name])
    @@unique([tenantId, groupId, parentId])
}

model MenuGroup {
    id        Int        @id @default(autoincrement())
    name      String     @unique
    position  Int        @default(0)
    tenantId  Int?
    tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    menus     MenuItem[]
    isActive  Boolean    @default(true)
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    @@unique([tenantId, name])
}

model AuditLog {
    id        Int         @id @default(autoincrement())
    action    AuditAction
    user      User        @relation(fields: [userId], references: [id])
    userId    Int
    tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    tenantId  Int?
    slug      String?
    metadata  Json        @default("{}")
    entity    String
    details   Json
    device    Json?
    createdAt DateTime    @default(now())

    @@index([action, createdAt])
    @@index([tenantId, createdAt])
    @@index([userId, createdAt])
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    LOGIN
    LOGOUT
    ERROR
}

model Notification {
    id        Int                @id @default(autoincrement())
    userId    Int
    topic     String?
    title     String?
    message   String
    status    NotificationStatus
    read      Boolean            @default(false)
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationStatus {
    SENT
    DELIVERED
    FAILED
}

model PushSubscription {
    id           Int      @id @default(autoincrement())
    userId       Int
    endpoint     String   @unique
    subscription Json
    topics       String[]
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}
