generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==== SCHOOL (multi-tenant) ====
model School {
  id              Int     @id @default(autoincrement())
  slug            String  @unique
  name            String
  description     String?
  website         String?
  establishedYear Int?
  contactEmail    String?
  contactPhone    String?
  address         Json?
  logo            String?
  favicon         String?
  primaryColor    String?
  secondaryColor  String?
  timezone        String? @default("UTC")
  defaultLanguage String? @default("en")
  currency        String? @default("INR")
  isActive        Boolean @default(false)

  // SaaS subscription fields
  subscriptionType   SubscriptionType   @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  maxStudents        Int?
  maxStaff           Int?
  activatedAt        DateTime?
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  grades        Grade[]
  students      Student[]
  staff         Staff[]
  subjects      Subject[]
  enrollments   Enrollment[]

  @@index([isActive])
  @@index([subscriptionStatus])
}

enum SubscriptionType {
  TRIAL
  BASIC
  STANDARD
  PREMIUM
  CUSTOM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ==== USER PROFILES ====
// Base profile for all user types
model Profile {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  phone       String?
  address     Json?     @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Only one of these should be set
  user    User?    @relation(fields: [userId], references: [id])
  userId  Int?     @unique
  student Student?
  staff   Staff?
}

// ==== PLATFORM/SCHOOL USER ====
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  userType  UserType  @default(SCHOOL_ADMIN)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // School-link (null for system users)
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId Int?

  // Links back to Staff or Student (one user linked to one entity only)
  staff   Staff? @relation(fields: [staffId], references: [id])
  staffId Int?   @unique

  student   Student? @relation(fields: [studentId], references: [id])
  studentId Int?     @unique

  profile Profile?
  roles   UserRole[]

  // Indexes
  @@index([schoolId])
  @@index([userType])
  @@index([isActive])
}

enum UserType {
  SYSTEM_ADMIN
  SUPPORT_ADMIN
  SCHOOL_ADMIN
  SCHOOL_STAFF
  SCHOOL_STUDENT
}

// ==== ROLES ====
model Role {
  id             Int        @id @default(autoincrement())
  name           String     @unique
  description    String?
  permissionMask Int        @default(0)
  users          UserRole[]

  @@index([permissionMask])
}

model UserRole {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId Int

  @@unique([userId, roleId])
}

// ==== ACADEMIC YEAR ====
model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String // e.g. "2024-2025"
  code      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades      Grade[]
  students    Student[]
  enrollments Enrollment[]

  @@unique([schoolId, code])
  @@index([isCurrent])
}

// ==== GRADE (class) ====
model Grade {
  id             Int          @id @default(autoincrement())
  name           String // e.g. "Grade 10"
  code           String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId       Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  academicYearId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sections    Section[]
  students    Student[]
  enrollments Enrollment[]
  subjects    Subject[]

  @@unique([schoolId, academicYearId, code])
  @@index([academicYearId])
}

// ==== SECTION (like "A", "B") ====
model Section {
  id      Int    @id @default(autoincrement())
  name    String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId Int

  students     Student[]
  enrollments  Enrollment[]
  staffMembers Staff[]      @relation("SectionStaff")

  @@unique([gradeId, name])
}

// ==== SUBJECT ====
model Subject {
  id      Int    @id @default(autoincrement())
  name    String
  code    String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId Int

  teacher   Staff? @relation("TeacherSubjects", fields: [teacherId], references: [id])
  teacherId Int?

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId Int

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]

  @@unique([schoolId, gradeId, code])
  @@index([teacherId])
}

// ==== STUDENT ====
model Student {
  id             Int           @id @default(autoincrement())
  studentId      String        @unique
  profile        Profile       @relation(fields: [profileId], references: [id])
  profileId      Int           @unique
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId       Int
  grade          Grade?        @relation(fields: [gradeId], references: [id])
  gradeId        Int?
  section        Section?      @relation(fields: [sectionId], references: [id])
  sectionId      Int?
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  academicYearId Int
  status         StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link back to User for login
  user User?

  enrollments Enrollment[]

  @@unique([schoolId, studentId])
  @@index([schoolId, status])
  @@index([gradeId, sectionId, status])
  @@index([academicYearId])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  TRANSFERRED
}

// ==== STAFF ====
model Staff {
  id        Int         @id @default(autoincrement())
  staffId   String      @unique
  profile   Profile     @relation(fields: [profileId], references: [id])
  profileId Int         @unique
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  Int
  position  String
  isTeacher Boolean     @default(false)
  isAdmin   Boolean     @default(false)
  status    StaffStatus @default(ACTIVE)

  user   User?
  userId Int?  @unique

  subjects Subject[] @relation("TeacherSubjects")
  sections Section[] @relation("SectionStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, staffId])
  @@index([isTeacher])
  @@index([status])
  @@index([schoolId, isAdmin])
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RETIRED
  TERMINATED
}

// ==== ENROLLMENT ====
model Enrollment {
  id             Int              @id @default(autoincrement())
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      Int
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId      Int
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      Int
  grade          Grade            @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId        Int
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId       Int
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  academicYearId Int
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([studentId, subjectId, academicYearId])
  @@index([schoolId, status])
  @@index([subjectId])
  @@index([gradeId, sectionId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  FAILED
  INCOMPLETE
}
