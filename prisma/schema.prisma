generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum TenantType {
  UNIVERSITY
  SOCIETY
  COLLEGE
  SCHOOL
}

model Tenant {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  description String?
  slug        String     @unique
  type        TenantType
  parent      Tenant?    @relation("TenantHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId    String?    @db.ObjectId
  children    Tenant[]   @relation("TenantHierarchy")
  address     Json       @default("{}")
  settings    Json       @default("{}")
  contact     Json       @default("{}")
  limits      Json       @default("{}") // Usage limits
  branding    Json       @default("{}") // Theme, logos, etc.
  customField Json       @default("{}")
  features    String[]   @default([]) // Feature flags
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  users          User[]
  roles          Role[]
  groups         MenuGroup[]
  menus          MenuItem[]
  permissions    Permission[]
  rolePermission RolePermission[]
  auditLogs      AuditLog[]

  @@index([type])
}

// Users
model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  password    String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId      String   @db.ObjectId
  globalRoles Json     @default("[]")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String?  @db.ObjectId
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional fields
  ip           String?
  customFields Json    @default("{}")

  // Relationship
  profile          Profile?
  auditLog         AuditLog[]
  notification     Notification[]
  pushSubscription PushSubscription[]

  @@index([tenantId, email])
}

enum GlobalRole {
  SUPER_ADMIN
  SYSTEM_ADMIN
  SUPPORT
}

model Profile {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName    String
  middleName   String?
  lastName     String
  dateOfBirth  DateTime?
  avatar       String?
  phone        String?
  address      Json?     @default("{}")
  customFields Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships - One profile per entity
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @unique @db.ObjectId

  @@index([firstName, lastName])
}

// ABAC-style Role
model Role {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  tenantId    String?          @db.ObjectId
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relationship
  user User[]

  @@unique([tenantId, name])
}

// Permissions associated with a specific Role and Menus
model RolePermission {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String? @db.ObjectId
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId         String  @db.ObjectId
  menuId         String  @db.ObjectId
  permissionBits Int // Bitmask permissions

  // Relationship
  role  Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menus MenuItem @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, roleId, menuId])
  @@index([tenantId, roleId])
  @@index([tenantId, menuId])
}

// Individual permission definitions (view, edit, delete, etc.)
model Permission {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String  @unique
  bitmask  Int
  tenantId String? @db.ObjectId
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isGlobal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId], name: "permission_name_tenant")
  @@index([tenantId, name])
}

// Modular structure (with self-referencing for hierarchy)
model MenuItem {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String?    @db.ObjectId
  tenant   Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  path     String?
  parentId String?    @db.ObjectId
  parent   MenuItem?  @relation("MenuParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children MenuItem[] @relation("MenuParent")
  groupId  String?    @db.ObjectId
  group    MenuGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship
  rolePermission RolePermission[]

  @@unique([tenantId, parentId, name])
  @@unique([tenantId, groupId, parentId])
}

// Grouping of Menus (e.g. Dashboard, Settings, etc.)
model MenuGroup {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  name     String     @unique
  position Int        @default(0)
  tenantId String?    @db.ObjectId
  tenant   Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menus    MenuItem[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model AuditLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  action    AuditAction
  user      User        @relation(fields: [userId], references: [id])
  userId    String      @db.ObjectId
  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String?     @db.ObjectId
  metadata  Json        @default("{}")
  entity    String
  details   Json
  device    Json?
  createdAt DateTime    @default(now())

  @@index([action, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ERROR
}

model Notification {
  id      String             @id @default(auto()) @map("_id") @db.ObjectId
  userId  String             @db.ObjectId
  topic   String?
  title   String?
  message String
  status  NotificationStatus
  read    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
}

model PushSubscription {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  endpoint     String   @unique
  subscription Json
  topics       String[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
