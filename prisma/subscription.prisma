model SubscriptionPlan {
  id          Int               @id @default(autoincrement())
  name        String            @unique           // e.g. "Basic", "Pro", "Enterprise"
  description String?           // "Includes 10 users, 5 projects, basic reporting"
  price       Float             // 29.99 (monthly)
  isActive    Boolean           @default(true)    // Whether plan is available for purchase
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  plans       Subscription[]    // All active subscriptions using this plan
  includedItems SubscriptionPlanItem[] // Menu items included in this plan
  // Example plan:
  // - Basic ($29): Dashboard, Calendar, Basic Reports
  // - Pro ($99): All Basic + Advanced Analytics, Team Collaboration
}

model Subscription {
  id               Int             @id @default(autoincrement())
  tenant           Tenant[]        // Tenant(s) using this subscription
  plan             SubscriptionPlan // Reference to the plan
  planId           Int
  startDate        DateTime        // When subscription began
  endDate          DateTime?       // When subscription expires (null for auto-renewing)
  isActive         Boolean         @default(true) // Active or cancelled
  isTrial          Boolean         @default(false) // Is this a trial subscription?
  trialEndDate     DateTime?       // When trial period ends
  autoRenew        Boolean         @default(true) // Whether to automatically renew
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  // Example subscription:
  // - Tenant "Acme Corp" on "Pro" plan
  // - Started 2023-01-01, renews annually
  // - Not a trial, active status
}

model SubscriptionPlanItem {
  id        Int             @id @default(autoincrement())
  plan      SubscriptionPlan // Which plan includes this item
  planId    Int
  menuItem  MenuItem        // The actual menu item included
  menuItemId Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  @@unique([planId, menuItemId]) // Prevent duplicate items in same plan
  // Example:
  // - Pro plan includes "Advanced Analytics" menu item
  // - Basic plan includes "Dashboard" menu item
}

model AddOn {
  id          Int               @id @default(autoincrement())
  name        String            @unique // "Advanced Reporting", "Premium Support"
  description String?           // "Additional reporting features for your plan"
  price       Float             // 19.99 (monthly add-on)
  isActive    Boolean           @default(true) // Available for purchase
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       AddOnItem[]       // Menu items this add-on unlocks
  tenantAddOns TenantAddOn[]    // Tenants who purchased this add-on
  // Example add-ons:
  // - "White Labeling" ($49): Custom branding items
  // - "API Access" ($29): API documentation and tools
}

model AddOnItem {
  id        Int             @id @default(autoincrement())
  addOn     AddOn           // Which add-on includes this
  addOnId   Int
  menuItem  MenuItem        // The menu item included
  menuItemId Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  @@unique([addOnId, menuItemId]) // Prevent duplicate items in same add-on
  // Example:
  // - "White Labeling" add-on includes "Brand Settings" menu
  // - "API Access" add-on includes "API Explorer" menu
}

model MenuItem {
  id             Int              @id @default(autoincrement())
  name           String           // "Dashboard", "Reports", "Settings"
  path           String?          // "/dashboard", "/reports"
  icon           String?          // "dashboard-icon", "chart-icon"
  category       String           // "Main Navigation", "Administration"
  sortOrder      Int              @default(0) // Display order in menu
  parentId       Int?             // For submenu items
  parent         MenuItem?        @relation("MenuHierarchy")
  children       MenuItem[]       @relation("MenuHierarchy")
  isActive       Boolean          @default(true) // Show/hide in UI
  isSystem       Boolean          @default(false) // true=managed by system
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant?          // null for system items
  tenantId       Int?             // Only set for custom tenant items
  rolePermission RolePermission[] // Permission requirements
  
  // Example system items:
  // - name: "Analytics", path: "/analytics", category: "Reports"
  // - name: "User Management", path: "/users", category: "Admin"
  
  // Example tenant custom item:
  // - name: "Custom Reports", tenantId: 123, category: "Reports"
}

model TenantAddOn {
  id          Int               @id @default(autoincrement())
  tenant      Tenant            // Which tenant purchased
  tenantId    Int
  addOn       AddOn             // Which add-on was purchased
  addOnId     Int
  isActive    Boolean           @default(true) // Can be disabled
  purchasedAt DateTime          @default(now()) // When add-on was bought
  updatedAt   DateTime          @updatedAt
  @@unique([tenantId, addOnId]) // Prevent duplicate add-ons per tenant
  // Example:
  // - Tenant "Acme Corp" purchased "White Labeling" add-on
  // - Active since 2023-01-15, currently active
}